{
  "app": {
    "port": 3000,
    "logLevel": "info"
  },
  "whatsapp": {
    "restoreOnBoot": true,
    "restoreStaggerMs": 1000,
    "printQrInTerminal": false,
    "maxSessionsPerUser": 5,
    "heartbeatIntervalMs": 30000,
    "reconnect": {
      "baseDelayMs": 1000,
      "maxDelayMs": 60000
    }
  },
  "database": {
    "path": "./data/bot.db",
    "maxMessagesPerGroup": 3000
  },
  "auth": {
    "jwtSecret": "replace-with-at-least-32-random-characters",
    "tokenTtlSeconds": 3600,
    "allowRegistration": false
  },
  "llm": {
    "apiKey": "",
    "model": "gemini-2.5-flash",
    "embeddingModel": "gemini-embedding-001",
    "temperature": 0.2,
    "requestTimeoutMs": 30000,
    "maxRetries": 1
  },
  "bot": {
    "candidatePoolSize": 30,
    "retrievalTopK": 8,
    "minSimilarity": 0.6,
    "minLexicalCoverage": 0.34,
    "contextTokenBudget": 1500,
    "maxOutputTokens": 512,
    "recentHistoryTurns": 4,
    "maxInputChars": 2000,
    "fallbackReply": "I couldn't find enough relevant context in this chat to answer that reliably. Could you rephrase or add more detail?"
  },
  "tracing": {
    "redact": true,
    "previewChars": 240,
    "maxFieldChars": 4000
  }
}
