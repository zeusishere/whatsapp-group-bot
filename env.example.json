{
  "app": {
    "port": 3000,
    "logLevel": "info"
  },
  "whatsapp": {
    "restoreOnBoot": true,
    "restoreStaggerMs": 1000,
    "printQrInTerminal": false,
    "maxSessionsPerUser": 5,
    "heartbeatIntervalMs": 30000,
    "reconnect": {
      "baseDelayMs": 1000,
      "maxDelayMs": 60000
    }
  },
  "database": {
    "path": "./data/bot.db",
    "maxMessagesPerGroup": 3000
  },
  "auth": {
    "jwtSecret": "replace-with-at-least-32-random-characters",
    "tokenTtlSeconds": 3600,
    "allowRegistration": false
  }
}
